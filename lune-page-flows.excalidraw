      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 CelesTrak (celestrak.org) \u2014 primary TLE source;\n  JSON \u2192 3LE text \u2192 scraped table fallback chain\n\u2022 tle.ivanstanojevic.me \u2014 backup TLE catalog,\n  rate-limited to ~500 req/day\n\u2022 unpkg CDN \u2014 Earth textures (three-globe)\n\u2022 world-atlas CDN \u2014 country border TopoJSON\n\u2022 Deploy target: Render (reads $PORT env var)",
      "originalText": "\u2022 CelesTrak (celestrak.org) \u2014 primary TLE source;\n  JSON \u2192 3LE text \u2192 scraped table fallback chain\n\u2022 tle.ivanstanojevic.me \u2014 backup TLE catalog,\n  rate-limited to ~500 req/day\n\u2022 unpkg CDN \u2014 Earth textures (three-globe)\n\u2022 world-atlas CDN \u2014 country border TopoJSON\n\u2022 Deploy target: Render (reads $PORT env var)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": true,
      "lineHeight": 1.25,
      "containerId": null
    },
